# Local demo credentials; change before exposing services outside your machine.
JWT_SECRET_KEY=local-demo-secret-replace-before-deploying
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=admin123
AUTH_VIEWER_USERNAME=viewer
AUTH_VIEWER_PASSWORD=viewer123
CLICKHOUSE_PASSWORD=clickhouse123
GRAFANA_ADMIN_PASSWORD=admin123
