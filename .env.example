# Environment variables for the application
# Copy this file to .env and fill in the values

#############################################
# Server Configuration
#############################################
SERVER_PORT=8080
GIN_MODE=release  # debug, release, or test

#############################################
# Kafka Configuration
#############################################
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_EVENTS=events
KAFKA_PRODUCER_TIMEOUT=10s
KAFKA_CONSUMER_GROUP=event-processor

#############################################
# ClickHouse Configuration
#############################################
CLICKHOUSE_HOST=clickhouse-server
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse123  # CHANGE IN PRODUCTION!
CLICKHOUSE_MAX_OPEN_CONNS=10
CLICKHOUSE_MAX_IDLE_CONNS=5

#############################################
# Application Configuration
#############################################
LOG_LEVEL=info  # debug, info, warn, error
LOG_FORMAT=json  # json or console
METRICS_ENABLED=true

#############################################
# JWT Configuration
#############################################
JWT_SECRET_KEY=your-secret-key-change-in-production  # CHANGE IN PRODUCTION!
JWT_TOKEN_EXPIRY=24h
JWT_REFRESH_EXPIRY=168h

#############################################
# CORS Configuration
#############################################
CORS_GRAFANA_ORIGIN=*  # Set to specific origin in production

#############################################
# Rate Limiting
#############################################
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

#############################################
# Processing Engine
#############################################
PROCESSOR_WINDOW_DURATION=60s
PROCESSOR_WORKER_COUNT=5
PROCESSOR_BATCH_WORKER_COUNT=5
PROCESSOR_ENABLE_METRICS=true
PROCESSOR_CRON_SCHEDULE=0 1 * * * *  # Daily at 1 AM (with seconds field)

#############################################
# Docker Image (for CI/CD)
#############################################
GO_API_IMAGE=project-go-api:latest
